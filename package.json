{
  "name": "tably-react",
  "version": "0.0.1",
  "description": "A customizable, dependency-free React table component written in TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohit-k-singh/tably-react.git"
  },
  "homepage": "https://github.com/rohit-k-singh/tably-react#readme",
  "bugs": {
    "url": "https://github.com/rohit-k-singh/tably-react/issues"
  },
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "component",
    "typescript",
    "tably"
  ],
  "author": "Rohit Kumar Singh",
  "license": "ISC",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "publint": "^0.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
